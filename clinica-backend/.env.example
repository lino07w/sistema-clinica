# ---------- Servidor ----------
PORT=3000
NODE_ENV=development

# URL pública del frontend (CORS y enlaces de los emails)
FRONTEND_URL=http://localhost:5173
# Orígenes adicionales permitidos, separados por comas (opcional)
CORS_ORIGIN=

# ---------- Seguridad ----------
# Obligatorio en producción. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
JWT_EXPIRE=7d

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Administrador inicial (se crea sólo si no existe ninguno).
# En producción, si no se define la contraseña, no se crea.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@clinica.com
DEFAULT_ADMIN_PASSWORD=123456

# ---------- Base de datos ----------
# Opción A: cadena de conexión (Neon, Render, Supabase, Vercel Postgres...)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Opción B: variables individuales
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_db
DB_USER=postgres
DB_PASSWORD=change_me
# SSL: por defecto true en producción, false en desarrollo
# DB_SSL=false
# DB_POOL_MAX=5

# ---------- Email (opcional) ----------
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Sistema Clínica" <noreply@clinica.com>
